{
  "manifest_version": 3,
  "name": "Ruzy · revisão de bugs (DEMONSTRAÇÃO)",
  "version": "0.1.0",
  "description": "Fila local de formulários simulados. Não acessa o Azure nem cria cards reais.",
  "permissions": ["storage"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "action": {"default_title": "Ruzy · ajuda e instalação", "default_popup": "help.html"},
  "content_scripts": [{
    "matches": ["file:///*", "http://127.0.0.1/*"],
    "js": ["report.js"], "css": ["report.css"], "run_at": "document_idle"
  }]
}
